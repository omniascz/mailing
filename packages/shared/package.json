{
  "name": "@forgemsg/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./beyond-core": {
      "types": "./dist/beyond-core/index.d.ts",
      "import": "./dist/beyond-core/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./sending/verp": {
      "types": "./dist/sending/verp.d.ts",
      "import": "./dist/sending/verp.js"
    },
    "./sending/isp-throttle": {
      "types": "./dist/sending/isp-throttle.d.ts",
      "import": "./dist/sending/isp-throttle.js"
    },
    "./viber/adapter": {
      "types": "./dist/viber/adapter.d.ts",
      "import": "./dist/viber/adapter.js"
    },
    "./viber/providers/infobip": {
      "types": "./dist/viber/providers/infobip.d.ts",
      "import": "./dist/viber/providers/infobip.js"
    },
    "./viber/providers/rakuten": {
      "types": "./dist/viber/providers/rakuten.d.ts",
      "import": "./dist/viber/providers/rakuten.js"
    },
    "./viber/providers/messagebird": {
      "types": "./dist/viber/providers/messagebird.d.ts",
      "import": "./dist/viber/providers/messagebird.js"
    },
    "./whatsapp/meta-adapter": {
      "types": "./dist/whatsapp/meta-adapter.d.ts",
      "import": "./dist/whatsapp/meta-adapter.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^25.6.0",
    "eslint": "^9.25.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  }
}
