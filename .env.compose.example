# docker-compose.prod.yml reads these from a `.env` file alongside it.
# Copy to `.env`, fill the REQUIRED block, then `docker compose -f
# docker-compose.prod.yml up -d --build`.
#
# Each app also has its own .env.example with more detail — see
# apps/api/.env.example for the full env-var inventory.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=change-me-to-a-long-random-string
JWT_SECRET=generate-with-openssl-rand-base64-64
API_PUBLIC_URL=https://api.example.com
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Host-side ports — defaults are container-internal 3001/3000/50051.
# Override if those clash on the host.
# API_PORT=3001
# WEB_PORT=3000
# MTA_PORT=50051

# Branded tracking subdomain. Falls back to API_PUBLIC_URL/t if unset.
# Recommended production setup: dedicated subdomain per-org via CNAME.
# TRACKING_BASE_URL=https://t.example.com

# Pino log level — trace | debug | info | warn | error
# LOG_LEVEL=info

# From address for ALL system mail: DOI confirmations, password reset,
# identity verification, operator alerts, scheduled reports. Required — the API
# will not start without it, and there is no default. Must be on a domain you
# control, with SPF and DKIM published.
SYSTEM_EMAIL_FROM=
SYSTEM_EMAIL_FROM_NAME=

# Optional. Scheduled-report sender, when a reply should reach a real mailbox.
# Must be on the same domain as SYSTEM_EMAIL_FROM. Leave unset to reuse it.
# REPORTS_FROM_EMAIL=

# Shared secret API expects on /internal/* endpoints (workers ↔ API).
# Both must match. Recommended: 32+ random chars.
# INTERNAL_API_SECRET=

# AI integrations
# ANTHROPIC_API_KEY=
# LITMUS_API_KEY=

# Stripe billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Beyond-core route groups (OPTIONAL — default: none) ─────────────────────
#
# Which parts of the product outside the core messaging surface this deployment
# registers, by name, comma-separated. Unset or empty means none, which is the
# default and what production runs today.
#
#   BEYOND_CORE_GROUPS=helpdesk,product-feed
#
# The api and workers services both read it and MUST get the same value — each
# beyond-core cron posts to an /api/v1/internal/* route that only exists when
# its group is registered on the API side.
#
# The dashboard needs nothing: it asks the API which groups are on
# (GET /api/v1/capabilities) per request, so a group appears in the navigation
# on the next page load, without rebuilding the web image.
#
# An unknown name refuses the boot, naming the offender and suggesting the near
# miss — a typo is a failed deploy, not a server that looks configured and
# serves nothing. Two groups are blocked outright and also refuse the boot,
# with the reason: `stock-alert` (its notify path marks every subscriber
# notified and sends nothing, so enabling it spends the list silently) and
# `ads-webhook` (double-gated by ENABLE_META_LEAD_ADS_WEBHOOK, so naming it
# here would read as enabled while changing nothing).
#
# The 76 valid names live in packages/shared/src/beyond-core/index.ts.
# BEYOND_CORE_GROUPS=
