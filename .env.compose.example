# docker-compose.prod.yml reads these from a `.env` file alongside it.
# Copy to `.env`, fill the REQUIRED block, then `docker compose -f
# docker-compose.prod.yml up -d --build`.
#
# Each app also has its own .env.example with more detail — see
# apps/api/.env.example for the full env-var inventory.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=change-me-to-a-long-random-string
JWT_SECRET=generate-with-openssl-rand-base64-64
API_PUBLIC_URL=https://api.example.com
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Host-side ports — defaults are container-internal 3001/3000/50051.
# Override if those clash on the host.
# API_PORT=3001
# WEB_PORT=3000
# MTA_PORT=50051

# Branded tracking subdomain. Falls back to API_PUBLIC_URL/t if unset.
# Recommended production setup: dedicated subdomain per-org via CNAME.
# TRACKING_BASE_URL=https://t.example.com

# Pino log level — trace | debug | info | warn | error
# LOG_LEVEL=info

# Default From address for DOI confirmation + verification emails.
# Must be on a verified sending domain.
# DOI_FROM_EMAIL=no-reply@example.com

# Shared secret API expects on /internal/* endpoints (workers ↔ API).
# Both must match. Recommended: 32+ random chars.
# INTERNAL_API_SECRET=

# AI integrations
# ANTHROPIC_API_KEY=
# LITMUS_API_KEY=

# Stripe billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
