# ─── MailForge production environment template ──────────────────────────────
#
# Copy to your secrets manager (Doppler / Vercel / 1Password / etc.) and
# verify with `pnpm --filter @forgemsg/api typecheck` after configuring.
# The API + workers + voice-bot all read these via Zod-validated loaders;
# missing required values fail fast at boot.
#
# Anything marked **REQUIRED** must be set. **RECOMMENDED** is optional but
# strongly suggested. **OPTIONAL** is genuinely optional.

# ─── Runtime ────────────────────────────────────────────────────────────────
# **REQUIRED** — controls error verbosity, log format, behind-CDN trust.
NODE_ENV=production
LOG_LEVEL=info

# ─── API service ────────────────────────────────────────────────────────────
# **REQUIRED** — public URL that customers + Stripe webhooks reach.
PORT=3001
API_BASE_URL=https://api.mailforge.io
API_PUBLIC_URL=https://api.mailforge.io
APP_URL=https://app.mailforge.io
WEB_URL=https://app.mailforge.io
# **REQUIRED** — comma-separated list, no trailing slashes.
CORS_ORIGIN=https://app.mailforge.io,https://mailforge.io

# ─── Tracking domain (optional but recommended) ─────────────────────────────
# When set, all click + open tracking URLs use this domain instead of
# api.<domain>. Improves deliverability slightly and gives the customer a
# branded link.
TRACKING_BASE_URL=https://t.mailforge.io

# ─── Datastores ─────────────────────────────────────────────────────────────
# **REQUIRED** — Hetzner managed Postgres or self-hosted on EX44.
# Always include sslmode=require for prod.
DATABASE_URL=postgresql://forgemsg:CHANGE_ME@postgres.internal.mailforge.io:5432/forgemsg?sslmode=require

# **OPTIONAL** — regional databases for EU/AP data residency on Business
# and Enterprise plans. Single region works fine for launch.
# EU_DATABASE_URL=postgresql://...
# AP_DATABASE_URL=postgresql://...

# **REQUIRED** — Redis 7+, evict policy MUST be `noeviction` for BullMQ.
REDIS_URL=redis://default:CHANGE_ME@redis.internal.mailforge.io:6379

# **RECOMMENDED** — only used by Aura analytics + cohort dashboards.
# Skip for launch; add when first Business customer needs cohort reports.
# CLICKHOUSE_URL=http://clickhouse.internal.mailforge.io:8123

# **OPTIONAL** — Kafka used for the high-volume event pipeline. Phase 3+ only.
# KAFKA_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092

# ─── Object storage ────────────────────────────────────────────────────────
# **REQUIRED** — Cloudflare R2 or AWS S3. MinIO only for self-hosted.
MINIO_ENDPOINT=eu-fra.r2.cloudflarestorage.com
MINIO_PORT=443
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=mailforge-prod
# Required in production like MINIO_BUCKET — video messages have their own store.
MINIO_VIDEO_BUCKET=mailforge-prod-videos
MINIO_USE_SSL=true

# ─── Secrets (REQUIRED — generate with: openssl rand -hex 32) ──────────────
# Rotate quarterly. Storing in Doppler is non-negotiable; never commit.
JWT_SECRET=CHANGE_ME_32_HEX_CHARS
SESSION_SECRET=CHANGE_ME_32_HEX_CHARS
INTERNAL_API_SECRET=CHANGE_ME_32_HEX_CHARS
# Also given to the engine (submission server) as-is — one value, one name.
INBOUND_EMAIL_SECRET=CHANGE_ME_32_HEX_CHARS
# Also given to the engine (inbound receiver) as-is — one value, one name.
DMARC_INBOUND_SECRET=CHANGE_ME_32_HEX_CHARS

# ─── External providers ────────────────────────────────────────────────────

# **REQUIRED** — Anthropic API key for the Claude calls baked into 19
# services. With AI quota enforcement enabled, runaway spend is capped per
# plan tier but a missing key breaks every AI feature.
ANTHROPIC_API_KEY=

# **REQUIRED** for SMS + voice tiers. Without these, the SMS gateway
# emits 503 and voice agent campaigns won't launch.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# **REQUIRED** for voice agent (speech-to-text).
DEEPGRAM_API_KEY=

# **REQUIRED** for voice agent (text-to-speech).
ELEVENLABS_API_KEY=

# **REQUIRED** — switch to live keys after KYC clears.
# `pk_live_…` is fine to expose in the web bundle; `sk_live_…` must never
# leave the API server.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email / DMARC ─────────────────────────────────────────────────────────
DMARC_REPORT_EMAIL=dmarc-reports@mailforge.io

# **RECOMMENDED** — Google Ads developer token, required when an org
# triggers a Customer Match audience sync. The flow fails actionably
# when missing.
# GOOGLE_ADS_DEVELOPER_TOKEN=

# ─── Sentry (RECOMMENDED) ──────────────────────────────────────────────────
# Without DSN the telemetry layer is a no-op — safe to launch without but
# every prod incident becomes much harder to debug.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
# Keep low at launch to stay inside the free tier.
SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── Instatus status page (RECOMMENDED) ────────────────────────────────────
# When either is unset the /internal/status-page/* endpoints respond with
# { available: false, status: 'noop' } — safe in dev, useless in prod.
INSTATUS_API_KEY=
INSTATUS_PAGE_ID=

# ─── Platform operator alerts (RECOMMENDED) ────────────────────────────────
# Where new-signup pings + abuse webhooks deliver. Set this to a real
# inbox you read — Slack + email both work via email-to-channel.
OPERATOR_EMAIL=ops@mailforge.io

# ─── Workers ───────────────────────────────────────────────────────────────
# **REQUIRED** — gRPC URL for the Go MTA engine. Locally that's
# localhost:50051; in prod, the internal hostname assigned by Coolify.
ENGINE_GRPC_URL=mta01.internal.mailforge.io:50051
# Tune for hardware: ~CPU cores × 4 is a sane starting point on EX44.
WORKER_CONCURRENCY=32

# ─── Voice bot ─────────────────────────────────────────────────────────────
VOICE_BOT_PORT=8787
VOICE_BOT_LANGUAGE=cs
VOICE_BOT_VOICE_ID=eleven_multilingual_v2

# ─── Beyond-core route groups (OPTIONAL — default: none) ─────────────────────
#
# Which parts of the product outside the core messaging surface this deployment
# registers, by name, comma-separated. Unset or empty means none, which is the
# default and what production runs today.
#
#   BEYOND_CORE_GROUPS=helpdesk,product-feed
#
# The api and workers services both read it and MUST get the same value — each
# beyond-core cron posts to an /api/v1/internal/* route that only exists when
# its group is registered on the API side.
#
# The dashboard needs nothing: it asks the API which groups are on
# (GET /api/v1/capabilities) per request, so a group appears in the navigation
# on the next page load, without rebuilding the web image.
#
# An unknown name refuses the boot, naming the offender and suggesting the near
# miss — a typo is a failed deploy, not a server that looks configured and
# serves nothing. Two groups are blocked outright and also refuse the boot,
# with the reason: `stock-alert` (its notify path marks every subscriber
# notified and sends nothing, so enabling it spends the list silently) and
# `ads-webhook` (double-gated by ENABLE_META_LEAD_ADS_WEBHOOK, so naming it
# here would read as enabled while changing nothing).
#
# The 76 valid names live in packages/shared/src/beyond-core/index.ts.
# BEYOND_CORE_GROUPS=
#
# ─── Recommended first deployment ───────────────────────────────────────────
#
# This project has never run in production, so there is no rollout to preserve
# and the first deploy gets to choose. The recommendation is two groups:
#
#   BEYOND_CORE_GROUPS=helpdesk,product-feed
#
# Measured on 2026-09-03 by enabling each of the nine groups that have a
# dashboard page, one at a time, against a real database. Both of these clear
# the readiness bar every other candidate misses on one count or another:
#
#   - every route is behind auth, or public by design (none is accidentally open)
#   - no GET answers 5xx  (helpdesk 3/3, product-feed 1/1 swept clean)
#   - the org filter is present everywhere it should be
#   - neither needs an environment variable that is not already set
#   - neither needs a cron or worker; nothing is left half-driven
#
# And the reason they are first rather than merely allowed: their dashboard page
# calls the endpoint that IS the feature. /helpdesk lists real tickets,
# /product-feeds lists real feeds. Loyalty, coupons and reviews also clear the
# bar, but their pages reach 1-3 endpoints out of 7-10 — a preview of a feature
# rather than the feature, and enabling one promises more than the dashboard can
# deliver.
#
# Not first, and why:
#   survey, ai-agent, meeting, ecommerce, loyalty-program, coupon, reviews-v2
#   — see the readiness probe. ecommerce additionally needs six Shopify/Shoptet
#   variables that nothing sets yet; meeting's 24h/1h reminders never fire.
#
# ─── One behaviour change, before you flip helpdesk ─────────────────────────
#
# While the group is off, services/inbound-rules substitutes an
# `email_reply_received` workflow event for the helpdesk action, because a
# ticket nobody can open is worse than no ticket. Turning the group on restores
# the ticket:
#
#   helpdesk OFF -> [{"type":"workflow_event","eventName":"email_reply_received"}]
#   helpdesk ON  -> [{"type":"helpdesk"}]
#
# So mail to support@ starts opening tickets again, and any automation keyed on
# `email_reply_received` for support addresses stops firing. That is the
# intended end state, not a regression — but it is the only item in this batch
# that changes an existing behaviour rather than unlocking a new surface, so
# check for such workflows before the deploy rather than after.
#
# Enabling is a deploy, not a migration: set the line, redeploy api AND workers
# with the same value, and read the result back from the boot log —
#
#   [env] beyond-core: 2 group(s) enabled — helpdesk, product-feed
#
# Reverting is deleting the line and redeploying. Nothing migrates, nothing is
# deleted.
