{
  "name": "@forgemsg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//exports": "Explicit list, deliberately not a ./dist/* wildcard: this is the entire surface apps/workers is allowed to reach into, and keeping it enumerated keeps that surface measurable.",
  "exports": {
    "./lib/queue-contracts": {
      "types": "./dist/lib/queue-contracts.d.ts",
      "import": "./dist/lib/queue-contracts.js"
    },
    "./services/campaigns/email-coupon-merge": {
      "types": "./dist/services/campaigns/email-coupon-merge.d.ts",
      "import": "./dist/services/campaigns/email-coupon-merge.js"
    },
    "./services/dedicated-ips": {
      "types": "./dist/services/dedicated-ips/index.d.ts",
      "import": "./dist/services/dedicated-ips/index.js"
    },
    "./services/push/mobile": {
      "types": "./dist/services/push/mobile.d.ts",
      "import": "./dist/services/push/mobile.js"
    },
    "./services/push/get-adapter": {
      "types": "./dist/services/push/get-adapter.d.ts",
      "import": "./dist/services/push/get-adapter.js"
    },
    "./services/rcs": {
      "types": "./dist/services/rcs/index.d.ts",
      "import": "./dist/services/rcs/index.js"
    },
    "./services/rcs/providers": {
      "types": "./dist/services/rcs/providers/index.d.ts",
      "import": "./dist/services/rcs/providers/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "seed:marketing-blog": "tsx scripts/seed-marketing-blog.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.0.0",
    "@forgemsg/editor": "workspace:*",
    "@forgemsg/i18n-cs": "workspace:*",
    "@forgemsg/i18n-sk": "workspace:*",
    "@forgemsg/shared": "workspace:*",
    "@sentry/node": "^8.0.0",
    "@shared/ai-provider": "workspace:*",
    "@shared/sms-sender": "workspace:*",
    "@shared/webhooks": "workspace:*",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.45.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "gif-encoder-2": "^1.0.5",
    "ioredis": "^5.10.1",
    "ipaddr.js": "2.3.0",
    "jsonwebtoken": "^9.0.3",
    "papaparse": "^5.4.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.0",
    "sharp": "^0.33.5",
    "stripe": "^17.0.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "puppeteer": "^23.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/papaparse": "^5.3.15",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vitest": "^3.1.0"
  }
}
