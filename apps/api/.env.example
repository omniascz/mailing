# Mailforge API — environment variables.
#
# Anything in REQUIRED must be set or the API will refuse to boot.
# Anything else is optional and only matters if you use that feature.
# In dev, copy this file to .env and the API picks it up via dotenv.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Postgres connection. Schema is provisioned via `pnpm db:push` from apps/api.
DATABASE_URL=postgresql://forgemsg:forgemsg@localhost:5432/forgemsg

# Redis (sessions, BullMQ queues, rate-limit counters, DOI tokens).
REDIS_URL=redis://localhost:6379

# JWT signing key. MUST be a strong random in production —
# `node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"`
JWT_SECRET=dev-only-secret-please-change-in-production

# ─── CORE-RECOMMENDED ────────────────────────────────────────────────────────

# Port the API listens on. Default 3001.
PORT=3001

# Externally visible URL of this API. Used to build absolute links in
# DOI confirmation emails, tracking pixels, signup-form embed scripts.
# Default falls back to a hard-coded localhost in some places, which
# breaks email links.
API_PUBLIC_URL=http://localhost:3001

# Externally visible URL of the web frontend. Used in redirect URIs for
# OAuth flows and as the default for password-reset / verify-email links.
APP_URL=http://localhost:3000

# Default tracking link prefix when an org hasn't verified a branded
# subdomain yet. e.g. https://t.mailforge.io
TRACKING_BASE_URL=http://localhost:3001

# CORS allow-list. Comma-separated origins, exact match. Defaults to the
# APP_URL above. Set to `*` only in dev — production must be a list.
CORS_ORIGIN=http://localhost:3000

# Log level: trace | debug | info | warn | error | fatal. Default info.
LOG_LEVEL=info

# development | production | test. Affects log format + auth cookie flags.
NODE_ENV=development

# ─── OPTIONAL INTEGRATIONS — set only if you use these features ──────────────

# AI agents (Claude). Without this key, /ai-agents pages render but
# "Run now" returns a 500.
# ANTHROPIC_API_KEY=

# Inbox preview provider. Defaults to a mock provider that returns fake
# screenshot URLs. Set to use real Litmus.
# LITMUS_API_KEY=
# INBOX_PREVIEW_PROVIDER=mock     # or 'litmus' (auto when LITMUS_API_KEY set)

# Stripe billing. /settings/billing breaks without these.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_PRO=price_xxx
# STRIPE_PRICE_BUSINESS=price_xxx
# STRIPE_PRICE_ENTERPRISE=price_xxx

# Object storage (uploaded CSV imports, brand assets, email screenshots).
# Defaults to local filesystem under IMPORT_UPLOAD_DIR. MinIO/S3 in prod.
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=mailforge
# MINIO_VIDEO_BUCKET=mailforge-videos
# MINIO_USE_SSL=false
# IMPORT_UPLOAD_DIR=/tmp/mailforge-imports

# Analytics DB (ClickHouse via a Postgres-compatible interface, or a
# separate Postgres in dev). Falls back to the main DATABASE_URL.
# AP_DATABASE_URL=

# Multi-region replica (EU residency for non-US orgs).
# EU_DATABASE_URL=

# Kafka — comma-separated broker list. Only needed in Phase 5+ when the
# event pipeline moves off BullMQ.
# KAFKA_BROKERS=

# CDP event topic name on Kafka. Defaults to "cdp-events".
# CDP_EVENT_TOPIC=cdp-events

# ─── OAUTH PROVIDERS — one section per provider ──────────────────────────────

# Google (sign-in + Google Ads OAuth)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Microsoft (sign-in + transactional via Microsoft Graph)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=

# Facebook + Meta (ads + lead forms)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PIXEL_ID=
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Twitter / LinkedIn / TikTok / Zoom — same shape, set only as needed.
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ADS_APP_ID=
# TIKTOK_ADS_SECRET=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_ACCOUNT_ID=

# CRM / ecommerce integrations
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=http://localhost:3001/api/v1/integrations/hubspot/callback
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SHOPTET_CLIENT_ID=
# SHOPTET_CLIENT_SECRET=
# SHOPTET_OAUTH_BASE=https://...
# SKLIK_CLIENT_ID=
# SKLIK_CLIENT_SECRET=
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=
# CALENDLY_REDIRECT_URI=

# ─── COMMS CHANNELS — SMS, voice, push ───────────────────────────────────────

# Twilio (primary SMS + voice)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY=
# TWILIO_API_KEY_SECRET=
# TWILIO_API_KEY_SID=
# TWILIO_API_SECRET=
# TWILIO_FROM_NUMBER=+420...
# TWILIO_TWIML_APP_SID=

# Telnyx (alternate SMS/voice provider, used as backup)
# TELNYX_API_KEY=
# TELNYX_CONNECTION_ID=
# TELNYX_PUBLIC_KEY=

# VoIP routing — which provider does outbound voice prefer.
# VOIP_PROVIDER=twilio

# Deepgram for voice-bot transcription
# DEEPGRAM_API_KEY=

# WhatsApp webhook (Meta Business)
# WHATSAPP_VERIFY_TOKEN=

# Web push notifications (VAPID identity)
# VAPID_EMAIL=admin@yourdomain.com

# ─── ENRICHMENT + DATA — third-party APIs ────────────────────────────────────

# Hunter (email validation + finder)
# HUNTER_API_KEY=

# Clearbit (company enrichment)
# CLEARBIT_API_KEY=

# DataForSEO (SEO module — rank tracker)
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# Embeddings provider — openai | voyage | (any custom). Default 'openai'.
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3-lite

# ─── E-SIGN PROVIDERS ────────────────────────────────────────────────────────

# ESIGN_PROVIDER=docusign      # or 'hellosign'
# DOCUSIGN_BASE_URL=https://demo.docusign.net
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_ACCESS_TOKEN=
# HELLOSIGN_API_KEY=

# ─── DELIVERABILITY — inbound webhook secrets ────────────────────────────────

# Token bouncer for ISP postmaster FBL endpoints — verifies that bounce
# reports actually came from the ISP, not random POSTs.
# FBL_WEBHOOK_SECRET=

# DMARC aggregate-report intake — same idea, gated POST endpoint.
# DMARC_INBOUND_SECRET=
# DMARC_REPORT_EMAIL=dmarc-reports@yourdomain.com

# Inbound email parsing (replies → ticket creation)
# INBOUND_EMAIL_SECRET=

# ─── OBSERVABILITY ───────────────────────────────────────────────────────────

# Sentry — leave SENTRY_DSN empty in dev to disable. Initialization is a
# no-op without a DSN. SENTRY_ENVIRONMENT defaults to NODE_ENV.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=$(git rev-parse --short HEAD)
# Lower sample rate = cheaper. 0.05 = 5 % of transactions traced.
# SENTRY_TRACES_SAMPLE_RATE=0.05

# ─── INTERNAL ────────────────────────────────────────────────────────────────

# Shared secret for internal endpoints (workers → API). Both API and
# workers must agree. Falls back to anyone-can-call in dev, which is
# fine on localhost — set both in prod.
# INTERNAL_API_SECRET=
# INTERNAL_SECRET=

# Compliance: org-level field encryption key for PHI/HIPAA columns.
# 32-byte base64. Without it, encrypted columns are inaccessible.
# HIPAA_FIELD_KEY=

# Migration helper — used by some legacy scripts to default an org_id.
# Never set this in production.
# DEFAULT_ORG_ID=
