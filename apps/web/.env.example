# Mailforge web (Next.js) — environment variables.
#
# Two flavours: NEXT_PUBLIC_* are inlined into the browser bundle (must
# not contain secrets). Plain ones run server-side only.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Browser-side API URL — used by client components doing fetch() calls
# from the browser. Must be reachable from the user's network, not just
# the server.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Server-side API URL — used by server components doing fetch() during
# SSR. Can be an internal hostname in production (e.g. http://api:3001
# inside docker-compose). Defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:3001

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Port the dev server / `next start` binds to. Default 3000.
# PORT=3000

# ─── OBSERVABILITY (Sentry) ──────────────────────────────────────────────────
# All empty in dev → Sentry init is a no-op. Set in production.
#
# NEXT_PUBLIC_SENTRY_DSN ships to the browser (must not contain secrets;
# Sentry DSNs are write-only so this is fine). SENTRY_DSN is server-side
# only — can be the same value or a different project for cleaner dash.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_DSN=                       # optional; falls back to NEXT_PUBLIC_SENTRY_DSN
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_RELEASE=$(git rev-parse --short HEAD)
# SENTRY_RELEASE=$(git rev-parse --short HEAD)
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.02   # browser: keep tiny
# SENTRY_TRACES_SAMPLE_RATE=0.05               # server: a bit higher
#
# Required only for source-map upload at build time. Without it,
# withSentryConfig is silent and ships unmapped stack traces.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=                # don't commit — set in CI / Vercel
