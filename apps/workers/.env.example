# Mailforge workers — environment variables.
#
# The worker process consumes BullMQ queues + calls back to the API.
# Required values must be set or the worker exits at boot.

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Same Redis as the API uses. Queues are namespaced by name so multiple
# environments can share a Redis as long as they use distinct queue names.
REDIS_URL=redis://localhost:6379

# Postgres URL for the small handful of jobs that read directly (archive,
# decay, retention enforcement). Most jobs go through the API instead.
DATABASE_URL=postgresql://forgemsg:forgemsg@localhost:5432/forgemsg

# Internal-facing URL the worker uses to call back into the API
# (audience resolution, contact loading, suppression checks).
#
# CRITICAL: use 127.0.0.1 not localhost — node:fetch in newer Node
# resolves localhost to ::1 first, but the API binds to 0.0.0.0 in a
# way that misses IPv6 loopback on Windows.
API_URL=http://127.0.0.1:3001

# Go MTA gRPC endpoint. host:port format, no scheme.
MTA_GRPC_ENDPOINT=127.0.0.1:50051

# ─── OPTIONAL ────────────────────────────────────────────────────────────────

# Shared secret API expects on `/api/v1/internal/*` endpoints. Both must
# agree. Without it, dev mode allows unauthenticated internal calls.
# INTERNAL_API_SECRET=
# INTERNAL_API_URL=          # legacy alias, prefer API_URL
# INTERNAL_SECRET=           # legacy alias, prefer INTERNAL_API_SECRET

# Default tracking link prefix for emails sent through the batch-sender.
# Falls back to API_URL/t if unset, but production should use a branded
# subdomain (e.g. https://t.yourdomain.com) verified per-org.
# TRACKING_BASE_URL=

# Email event archival threshold. Events older than this go to cold
# storage (S3/MinIO), reducing main-DB row count. Default 180 days.
# ARCHIVE_CUTOFF_DAYS=180

# Log level (uses console.log directly, so this just gates verbosity).
# NODE_ENV=development

# ─── OBSERVABILITY ───────────────────────────────────────────────────────────

# Sentry — same DSN as the API can be used (they're separate projects in
# Sentry though, so create one project per service for clean dashboards).
# No-op when empty.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=$(git rev-parse --short HEAD)
# SENTRY_TRACES_SAMPLE_RATE=0.05
