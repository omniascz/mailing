# ─── Mobile push ─────────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_KEY_P8=                 # PEM contents, not a path
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=             # true = Apple production gateway
FCM_SERVICE_ACCOUNT=         # service-account JSON
VAPID_EMAIL=                 # web-push contact address

# ─── SMTP engine: submission (587) + inbound (MX) servers ────────────────────
# These run inside apps/engine and talk back to the API's internal endpoints.
# Each authenticates with the SAME env var the API validates against — one
# value, one name, set once. Do NOT invent SUBMISSION_API_SECRET /
# INBOUND_API_SECRET aliases: a second name for the same secret is a trap
# (set one and not the other, or set them differently, and the API rejects
# every call with a 401 that reads as a wrong password).
SUBMISSION_LISTEN=           # e.g. :587 — unset disables the submission server
SUBMISSION_API_URL=          # base API URL the engine relays to (e.g. http://api:3001)
# → authenticates with INTERNAL_API_SECRET (above), sent as X-Internal-Secret.
SUBMISSION_TLS_CERT=         # PEM cert path → enables STARTTLS
SUBMISSION_TLS_KEY=          # PEM key path
SUBMISSION_ALLOW_INSECURE_AUTH=  # 1 = permit AUTH without TLS (only behind a TLS-terminating proxy)
INBOUND_LISTEN=              # e.g. :25 — unset disables the inbound receiver
INBOUND_API_URL=             # inbound-email endpoint the engine forwards to
# → authenticates with INBOUND_EMAIL_SECRET (above), sent as X-Inbound-Secret.

# ─── Deliverability / reputation ─────────────────────────────────────────────
SENDERSCORE_API_KEY=
SEZNAM_POSTMASTER_API_KEY=   # CZ mailbox provider reputation
SMTP_SUBMISSION_HOST=        # host advertised by the SMTP relay
INBOX_PREVIEW_PROVIDER=      # litmus | none
LITMUS_API_KEY=

# ─── Data enrichment / AI ────────────────────────────────────────────────────
CLEARBIT_API_KEY=
HUNTER_API_KEY=              # email verification
GENDERIZE_API_KEY=           # international gender inference fallback
