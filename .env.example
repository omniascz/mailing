# ─── ForgeMsg environment template ───────────────────────────────────────────
#
# Copy to `.env.local` (or per-app `.env`) and fill in. Each app has a
# Zod-validated loader at `src/config/env.ts` that fails fast at boot if any
# required-in-production var is missing or malformed.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── API service ─────────────────────────────────────────────────────────────
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Datastores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://forgemsg:forgemsg@localhost:5432/forgemsg
# Optional regional databases for EU/AP data residency.
# EU_DATABASE_URL=postgresql://...
# AP_DATABASE_URL=postgresql://...
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
KAFKA_BROKERS=localhost:9092

# ─── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=forgemsg
MINIO_USE_SSL=false

# ─── Secrets (REQUIRED in production) ────────────────────────────────────────
# Generate strong values: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production
SESSION_SECRET=dev-cookie-secret-change-in-production
INTERNAL_API_SECRET=dev-internal-secret-change-in-production
DMARC_INBOUND_SECRET=dev-dmarc-inbound-secret

# ─── External providers ──────────────────────────────────────────────────────
# Required by AI features, voice-bot, billing.
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email / DMARC ───────────────────────────────────────────────────────────
DMARC_REPORT_EMAIL=dmarc-reports@forgemsg.com

# ─── Workers ─────────────────────────────────────────────────────────────────
ENGINE_GRPC_URL=localhost:50051
WORKER_CONCURRENCY=10

# ─── Voice bot ───────────────────────────────────────────────────────────────
VOICE_BOT_PORT=8787
VOICE_BOT_LANGUAGE=cs
VOICE_BOT_VOICE_ID=eleven_multilingual_v2

# ═════════════════════════════════════════════════════════════════════════════
# NOT in the Zod schema
# ═════════════════════════════════════════════════════════════════════════════
# Everything below is read via raw `process.env` somewhere in apps/api and is
# NOT validated at boot — a typo is silently an empty string, and a missing
# value shows up as a runtime failure in whichever feature needed it. They are
# listed here so at least the set is discoverable. Moving them into the schema
# is separate work.
#
# Leave blank to disable the feature that uses it; most call sites treat an
# empty value as "integration not configured".

# ─── Core URLs / identity ────────────────────────────────────────────────────
API_PUBLIC_URL=              # public origin of this API (DOI links, tracking pixels) — REQUIRED in prod
APP_URL=                     # public origin of the web app — REQUIRED in prod
APP_BASE_URL=                # legacy alias of APP_URL used by referral + GDPR routes
WEB_BASE_URL=                # legacy alias used by the e-commerce OAuth callbacks
API_URL=                     # internal base URL workers use to reach the API
TRACKING_BASE_URL=           # branded open/click tracking domain
COOKIE_DOMAIN=               # parent domain for the session cookie when API and web are on different hosts
SINK_DOMAIN=                 # sink addresses used to simulate delivery outcomes
DEFAULT_ORG_ID=              # fallback org for scripts that predate multi-tenancy

# ─── System email senders ────────────────────────────────────────────────────
SYSTEM_EMAIL_FROM=
SYSTEM_EMAIL_FROM_NAME=
SYSTEM_FROM_EMAIL=           # third spelling in use; call sites differ
REPORTS_FROM_EMAIL=          # scheduled-report delivery
DOI_FROM_EMAIL=              # double opt-in confirmation sender
DOI_FROM_DOMAIN=

# ─── Signing / internal secrets (unvalidated — see note above) ───────────────
INTERNAL_SECRET=             # legacy name; INTERNAL_API_SECRET is the validated one
ASSET_SIGNING_SECRET=        # signs digital-asset download links
INBOUND_EMAIL_SECRET=        # verifies inbound MX webhook posts
FBL_WEBHOOK_SECRET=          # feedback-loop (complaint) webhook
FORM_AUTOFILL_SECRET=        # signs form autofill tokens
PREFERENCE_CENTRE_SECRET=    # signs preference-centre links
PARTNER_PROVISION_SECRET=    # partner provisioning API
HIPAA_FIELD_KEY=             # field-level encryption key for HIPAA mode

# ─── ClickHouse ──────────────────────────────────────────────────────────────
CLICKHOUSE_ENABLED=
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ─── Object storage extras ───────────────────────────────────────────────────
MINIO_VIDEO_BUCKET=
ASSET_STORAGE_BUCKET=
AWS_REGION=

# ─── Google (OAuth login, Ads, Postmaster) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_POSTMASTER_TOKEN=     # Postmaster Tools reputation API

# ─── Microsoft (OAuth, SNDS) ─────────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_SNDS_API_KEY=      # Smart Network Data Services reputation feed
MS_CLIENT_ID=                # second spelling used by the calendar integration
MS_CLIENT_SECRET=
MS_TENANT=

# ─── Meta / Facebook / Instagram / WhatsApp ──────────────────────────────────
META_APP_SECRET=
META_API_VERSION=
META_ORG_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PIXEL_ID=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ─── Other ad platforms ──────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
SKLIK_CLIENT_ID=             # Seznam.cz ads (CZ market)
SKLIK_CLIENT_SECRET=

# ─── CRM / commerce integrations ─────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPTET_CLIENT_ID=           # CZ e-commerce platform
SHOPTET_CLIENT_SECRET=
SHOPTET_OAUTH_BASE=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
