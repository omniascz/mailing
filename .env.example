CLICKHOUSE_ENABLED=
CLICKHOUSE_DATABASE=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# ─── Object storage extras ───────────────────────────────────────────────────
MINIO_VIDEO_BUCKET=
