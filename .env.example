# ─── Telephony / SMS / RCS ───────────────────────────────────────────────────
VOIP_PROVIDER=               # twilio | telnyx
TWILIO_FROM_NUMBER=
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_CONNECTION_ID=
RCS_PROVIDER=
RCS_SINCH_BOT_ID=
RCS_SINCH_TOKEN=
RCS_SINCH_REGION=
VOICE_BOT_WSS_URL=

# ─── Mobile push ─────────────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_KEY_P8=                 # PEM contents, not a path
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=             # true = Apple production gateway
FCM_SERVICE_ACCOUNT=         # service-account JSON
VAPID_EMAIL=                 # web-push contact address

# ─── Deliverability / reputation ─────────────────────────────────────────────
SENDERSCORE_API_KEY=
SEZNAM_POSTMASTER_API_KEY=   # CZ mailbox provider reputation
SMTP_SUBMISSION_HOST=        # host advertised by the SMTP relay
INBOX_PREVIEW_PROVIDER=      # litmus | none
LITMUS_API_KEY=

# ─── Data enrichment / AI ────────────────────────────────────────────────────
CLEARBIT_API_KEY=
HUNTER_API_KEY=              # email verification
GENDERIZE_API_KEY=           # international gender inference fallback
GEOIP_API_URL=
DATAFORSEO_LOGIN=            # SEO rank polling
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
EMBEDDING_PROVIDER=          # openai | voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=

# ─── Billing price IDs ───────────────────────────────────────────────────────
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_ENTERPRISE=

# ─── Misc ────────────────────────────────────────────────────────────────────
OPERATOR_EMAIL=              # platform-operator alerts (signups, abuse)
IMPORT_UPLOAD_DIR=           # dev-only CSV upload path
CDP_EVENT_TOPIC=
DATA_REGION_OVERRIDES=       # per-org data-residency overrides
