# ─── Telephony / SMS / RCS ───────────────────────────────────────────────────
VOIP_PROVIDER=               # twilio | telnyx
TWILIO_FROM_NUMBER=
TWILIO_TWIML_APP_SID=
TWILIO_API_KEY=
