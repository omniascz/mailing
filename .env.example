# ─── ForgeMsg environment template ───────────────────────────────────────────
#
# Copy to `.env.local` (or per-app `.env`) and fill in. Each app has a
# Zod-validated loader at `src/config/env.ts` that fails fast at boot if any
# required-in-production var is missing or malformed.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Product scope ───────────────────────────────────────────────────────────
# Domains outside the core product (CRM, helpdesk, booking, loyalty, commerce,
# ads, CDP, SEO, social, blog, reviews, surveys, coupons, AI agents). Off in
# production: their API routes are not registered, so they are absent from
# /docs/json and answer 404, and their crons do not run. Nothing is deleted.
# Defaults to on outside production so they keep being developed and tested.
FEATURE_BEYOND_CORE=true
# apps/web reads the same switch through Next's public env.
NEXT_PUBLIC_FEATURE_BEYOND_CORE=true

# ─── API service ─────────────────────────────────────────────────────────────
PORT=3001
API_BASE_URL=http://localhost:3001
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ─── Datastores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://forgemsg:forgemsg@localhost:5432/forgemsg
# Optional regional databases for EU/AP data residency.
# EU_DATABASE_URL=postgresql://...
# AP_DATABASE_URL=postgresql://...
REDIS_URL=redis://localhost:6379
CLICKHOUSE_URL=http://localhost:8123
KAFKA_BROKERS=localhost:9092

# ─── Object storage (MinIO in dev, S3 in prod) ───────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=forgemsg
MINIO_USE_SSL=false

# ─── Secrets (REQUIRED in production) ────────────────────────────────────────
# Generate strong values: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production
SESSION_SECRET=dev-cookie-secret-change-in-production
INTERNAL_API_SECRET=dev-internal-secret-change-in-production
# INBOUND_EMAIL_SECRET guards the inbound-email endpoint (X-Inbound-Secret).
INBOUND_EMAIL_SECRET=dev-inbound-email-secret-change-me-32
DMARC_INBOUND_SECRET=dev-dmarc-inbound-secret
# Signs the open pixel, every wrapped link, the unsubscribe link and the
# preference-centre token. The API and the workers must be given the SAME value:
# the workers sign, the API verifies. Read in packages/shared, so it applies to
# both processes.
TRACKING_SECRET=dev-tracking-secret-change-me-32ch

# ─── External providers ──────────────────────────────────────────────────────
# Required by AI features, voice-bot, billing.
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Inbound webhook switches ────────────────────────────────────────────────
# STRIPE_WEBHOOK_SECRET above is now REQUIRED for the two Stripe webhook
# endpoints: a missing or empty value refuses the request instead of skipping
# verification, and docker-compose.prod.yml no longer supplies a default.
#
# Accept an UNSIGNED webhook because you said so, not because a secret is
# missing. Ignored when NODE_ENV=production.
ALLOW_UNSIGNED_WEBHOOKS=      # "true" to allow, dev only

# Endpoints that are off by default. Their signature verification opens when
# the secret is unset and has deliberately NOT been repaired — we are not
# launching these. Setting the flag alone is not enough for the Meta family:
# the app secret has to be present too, or the endpoint stays off.
ENABLE_META_LEAD_ADS_WEBHOOK= # "true"; needs META_APP_SECRET or FACEBOOK_APP_SECRET
ENABLE_INSTAGRAM_WEBHOOK=     # "true"; needs META_APP_SECRET
ENABLE_MESSENGER_WEBHOOK=     # "true"; needs META_APP_SECRET
ENABLE_META_WEBHOOK=          # "true"; needs META_APP_SECRET
ENABLE_WHATSAPP_WEBHOOK=      # "true"; needs META_APP_SECRET or WHATSAPP_APP_SECRET
ENABLE_TELNYX_WEBHOOK=        # "true"; its verifier is a stub — see webhook-switches.ts

# ─── Email / DMARC ───────────────────────────────────────────────────────────
DMARC_REPORT_EMAIL=dmarc-reports@forgemsg.com

# ─── Workers ─────────────────────────────────────────────────────────────────
ENGINE_GRPC_URL=localhost:50051
WORKER_CONCURRENCY=10

# ─── Voice bot ───────────────────────────────────────────────────────────────
VOICE_BOT_PORT=8787
VOICE_BOT_LANGUAGE=cs
VOICE_BOT_VOICE_ID=eleven_multilingual_v2

# ═════════════════════════════════════════════════════════════════════════════
# NOT in the Zod schema
# ═════════════════════════════════════════════════════════════════════════════
# Everything below is read via raw `process.env` somewhere in apps/api and is
# NOT validated at boot — a typo is silently an empty string, and a missing
# value shows up as a runtime failure in whichever feature needed it. They are
# listed here so at least the set is discoverable. Moving them into the schema
# is separate work.
#
# Leave blank to disable the feature that uses it; most call sites treat an
# empty value as "integration not configured".

# ─── Core URLs / identity ────────────────────────────────────────────────────
API_PUBLIC_URL=              # public origin of this API (DOI links, tracking pixels) — REQUIRED in prod
APP_URL=                     # public origin of the web app — REQUIRED in prod
APP_BASE_URL=                # legacy alias of APP_URL used by referral + GDPR routes
WEB_BASE_URL=                # legacy alias used by the e-commerce OAuth callbacks
API_URL=                     # internal base URL workers use to reach the API
TRACKING_BASE_URL=           # branded open/click tracking domain
COOKIE_DOMAIN=               # parent domain for the session cookie when API and web are on different hosts
SINK_DOMAIN=                 # sink addresses used to simulate delivery outcomes

# VERP envelope sender domain — the Return-Path bulk sends go out with, so an
# out-of-band DSN can be matched back to the message that caused it. REQUIRED IN
# PRODUCTION: without it the Return-Path is empty, the engine falls back to the
# header From, and bounces land in the customer's mailbox instead of ours.
# Must be a bare domain, and its MX has to point at the inbound receiver.
VERP_BOUNCE_DOMAIN=          # e.g. bounce.<your-domain> — required in production
DEFAULT_ORG_ID=              # fallback org for scripts that predate multi-tenancy

# ─── System email sender ─────────────────────────────────────────────────────
# REQUIRED, NO DEFAULT. The API refuses to boot without these two — in every
# environment, dev included. Left blank here on purpose: blank is the value the
# loader rejects, so copying this file and forgetting to fill it in fails loudly
# instead of sending from somewhere you do not own. Do not put a plausible
# address here; a syntactically valid placeholder would pass validation and boot.
#
# This is the sender for ALL system mail: double opt-in confirmations, password
# reset, email-identity verification, operator alerts, workflow internal
# notifications, scheduled reports. It replaces SYSTEM_FROM_EMAIL,
# DOI_FROM_EMAIL and DOI_FROM_DOMAIN, which no longer exist.
# Must be on a domain you control, with SPF and DKIM published.
SYSTEM_EMAIL_FROM=           # required, no default — e.g. no-reply@<your-domain>
SYSTEM_EMAIL_FROM_NAME=      # required, no default — display name, e.g. ForgeMsg

# Optional. Only for scheduled-report delivery, where a reply may be wanted.
# Unset (or empty) means reports go out as SYSTEM_EMAIL_FROM. When set it MUST
# be on the same domain as SYSTEM_EMAIL_FROM, or the API refuses to boot.
REPORTS_FROM_EMAIL=          # optional override, same domain as SYSTEM_EMAIL_FROM

# ─── Signing / internal secrets ──────────────────────────────────────────────
# These are now VALIDATED (see the Secrets block near the top) — required in
# production, dev defaults otherwise. Listed here for discoverability.

