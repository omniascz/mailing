# ─── CRM / commerce integrations ─────────────────────────────────────────────
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPTET_CLIENT_ID=           # CZ e-commerce platform
SHOPTET_CLIENT_SECRET=
SHOPTET_OAUTH_BASE=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
