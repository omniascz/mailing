DATAFORSEO_LOGIN=            # SEO rank polling
DATAFORSEO_PASSWORD=
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=
EMBEDDING_PROVIDER=          # openai | voyage
VOYAGE_API_KEY=
VOYAGE_MODEL=

# ─── Billing price IDs ───────────────────────────────────────────────────────
