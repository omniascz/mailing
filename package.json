{
  "name": "forgemsg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint --continue",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "seed": "pnpm --filter @forgemsg/api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver",
      "core-js-pure"
    ],
    "overrides": {
      "form-data@<4.0.4": "^4.0.4",
      "fast-uri@<3.1.2": "^3.1.2",
      "lodash@<4.17.21": "^4.17.21",
      "basic-ftp@<5.3.1": "^5.3.1",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "ws@<8.20.1": "^8.20.1",
      "@fastify/static@<8.2.0": "^8.2.0",
      "brace-expansion@<2.0.2": "^2.0.2",
      "uuid@<11.0.0": "^11.0.0",
      "postcss@<8.4.49": "^8.4.49",
      "ip-address@<10.0.1": "^10.0.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "turbo": "^2.5.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  }
}
