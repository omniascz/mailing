{
  "name": "forgemsg",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint --continue",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "seed": "pnpm --filter @forgemsg/api seed"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver",
      "core-js-pure"
    ],
    "overrides": {
      "basic-ftp@<5.3.1": "^5.3.1",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "uuid@<11.0.0": "^11.0.0",
      "ip-address@<10.0.1": "^10.0.1",
      "rollup@<3.30.0": "3.30.0",
      "lodash": "^4.18.1",
      "form-data@<4.0.6": "^4.0.6",
      "fast-uri@<3.1.4": "^3.1.4",
      "ws@<8.21.0": "^8.21.0",
      "@fastify/static@<10.1.1": "^10.1.1",
      "postcss@<8.5.18": "^8.5.18",
      "find-my-way@<9.7.0": "^9.7.0",
      "js-yaml@<4.3.0": "^4.3.0",
      "tmp@<0.2.6": "^0.2.6",
      "protobufjs@<7.6.1": "^7.6.1",
      "@grpc/grpc-js@<1.14.4": "^1.14.4",
      "brace-expansion@>=2.0.0 <2.1.3": "^2.1.3",
      "brace-expansion@>=3.0.0 <5.0.8": "^5.0.8"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "turbo": "^2.5.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  }
}
